        "parameters": [
          {
            "name": "view",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "period",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "all",
                "today",
                "week",
                "overdue",
                "upcoming",
                "done",
                "archived"
              ]
            }
          },
          {
            "name": "q",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "board",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "assignee",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "job",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "status",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "priority",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Önceki nextCursor değerini değiştirmeden gönderin."
          },
          {
            "name": "updatedSince",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "ISO UTC zamanı; arşivlenen kayıtlar dahil."
          },
          {
            "name": "sourceRef",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Kaynak referansında tam eşleşme."
          },
          {
            "name": "team",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "Ekip kimliği."
          },
          {
            "name": "sent",
            "in": "query",
            "schema": {
              "type": "boolean"
            },
            "description": "Gönderenin kişiye özel görevleri"
          },
          {
            "name": "unassigned",
            "in": "query",
            "schema": {
              "type": "boolean"
            },
            "description": "Atanmamış ekip görevleri"
          }
        ]
      },
      "post": {
        "summary": "Görev oluştur",
        "description": "Gerekli kapsam: tasks:write. Kayıt ve profil yetkisi ayrıca kontrol edilir.",
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 8,
              "maxLength": 128
            },
            "description": "Her mantıksal yazma için tekil anahtar. Ağ tekrarında aynı anahtarı kullanın."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateTask"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "İşlem ve tekrar yanıtı aynı transaction içinde kaydedildi; aynı anahtar aynı gövdeyle tekrar oynatılır.",
            "content": {
              "application/json": {
