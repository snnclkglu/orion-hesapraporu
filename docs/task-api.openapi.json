          "404": {
            "description": "Uç bulunamadı",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Sürüm, kaynak veya tekrar anahtarı çakışması",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
