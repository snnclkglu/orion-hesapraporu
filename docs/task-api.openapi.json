{
  "openapi": "3.1.0",
  "info": {
    "title": "ORION Görev API",
    "version": "1.1.0",
    "description": "Grokbot ve diğer harici ajanlar için görev yönetimi. E-posta/AI analizi bu API'nin parçası değildir."
  },
  "servers": [
    {
      "url": "https://app.orioncranes.com/api/agent"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/tasks/{id}/workflow": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        }
      ],
      "get": {
        "summary": "Görev akışını oku",
        "description": "tasks:read gerekir; beklenen görevlerde erişim ayrıca denetlenir.",
        "responses": {
          "200": {
            "description": "Kontrol listesi, tekrar, waiting_for (id/title/status) ve yetkili next_task kimliği"
          },
          "403": {
            "description": "Kayıt yetkisi yok"
          },
          "503": {
            "description": "Servis kullanılamıyor"
          }
        }
      },
      "patch": {
        "summary": "Kontrol listesi, tekrar ve beklenen görevleri güncelle",
        "description": "tasks:write gerekir. Sürüm ve tekrar anahtarı zorunludur. Bağlantılar aynı paylaşım kapsamında olmalıdır; döngü kabul edilmez.",
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 8,
              "maxLength": 128
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/WorkflowUpdate"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Atomik işlem; yeniden denemede aynı sonuç",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TaskResult"
                }
              }
            }
          },
          "401": {
            "description": "Geçersiz oturum"
          },
          "403": {
            "description": "Yetki yok"
          },
          "409": {
            "description": "Sürüm veya tekrar anahtarı çakışması"
          },
          "422": {
            "description": "Akış kuralı ihlali"
          },
          "429": {
            "description": "İstek sınırı"
          },
          "503": {
            "description": "Servis kullanılamıyor"
          }
        }
      }
    },
    "/tasks": {
